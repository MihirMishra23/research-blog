---
import { getCollection } from 'astro:content';
import StaticLlmMap from '../components/StaticLlmMap.astro';
import { siteHref } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout>
  <header class="intro">
    <p class="eyebrow">Mihir Mishra’s research blog</p>
    <h1>The LLM Map</h1>
    <p>A compact view of the language-model ideas I’m exploring.</p>
  </header>

  <main>
    <section class="map-section" aria-labelledby="map-title">
      <h2 id="map-title" class="visually-hidden">LLM concept map</h2>
      <StaticLlmMap />
    </section>

    <section class="posts" aria-labelledby="posts-title">
      <p class="section-label">Writing</p>
      <h2 id="posts-title">Blog posts</h2>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={siteHref(`/posts/${post.id}/`)}>{post.data.title}</a>
              {post.data.status === 'stub' && <span>Coming soon</span>}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
