---
import { getCollection } from 'astro:content';
import LlmMap from '../components/LlmMap.astro';
import { createLlmMapModel } from '../content/map-model';
import { topicsForCurrentMap } from '../content/visibility';
import BaseLayout from '../layouts/BaseLayout.astro';

const topics = topicsForCurrentMap(await getCollection('topics'));
const model = createLlmMapModel(topics);
---

<BaseLayout
  title="Interactive map preview"
  description="An editorial interactive map connecting the initial LLM concepts."
>
  <header class="map-preview__header">
    <p class="eyebrow">Component QA · interaction V1</p>
    <h1>Isolated map preview</h1>
    <p>
      Select a concept bubble to inspect its immediate neighborhood, or use the
      semantic list after the drawing. The finished experience also appears on
      the homepage and the focused map route.
    </p>
  </header>
  <LlmMap model={model} />
</BaseLayout>
