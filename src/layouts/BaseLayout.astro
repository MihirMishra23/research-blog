---
import ThemeToggle from '../components/ThemeToggle.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import { siteConfig, sitePath } from '../config/site';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  updatedTime?: Date | string;
  searchable?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.socialImage,
  type = 'website',
  publishedTime,
  updatedTime,
  searchable = false,
} = Astro.props;
const documentTitle =
  title === siteConfig.title ? title : `${title} · ${siteConfig.title}`;
const canonicalUrl = new URL(
  Astro.url.pathname,
  siteConfig.deployment.origin,
).toString();
const socialImageUrl = new URL(
  sitePath(image),
  siteConfig.deployment.origin,
).toString();
const rssUrl = new URL(
  sitePath('/rss.xml'),
  siteConfig.deployment.origin,
).toString();
const isMapPage =
  Astro.url.pathname === sitePath('/') ||
  Astro.url.pathname.startsWith(sitePath('/map/')) ||
  Astro.url.pathname.startsWith(sitePath('/map-preview/'));
const isWritingPage = Astro.url.pathname.startsWith(sitePath('/writing/'));
const isTopicsPage = Astro.url.pathname.startsWith(sitePath('/topics/'));
const isResearchPage = Astro.url.pathname.startsWith(sitePath('/research/'));
const isAboutPage = Astro.url.pathname.startsWith(sitePath('/about/'));
const isSearchPage = Astro.url.pathname.startsWith(sitePath('/search/'));
const isUtilityPage = [
  '/content-preview/',
  '/map-preview/',
  '/rendering-test/',
].some((path) => Astro.url.pathname.startsWith(sitePath(path)));
const shouldIndexPage = searchable && !isUtilityPage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href={rssUrl}
    />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={sitePath('/favicon-32.png')}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={sitePath('/apple-touch-icon.png')}
    />
    <link rel="manifest" href={sitePath('/site.webmanifest')} />
    <meta name="theme-color" content="#181916" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The LLM Map knowledge graph mark" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={new Date(publishedTime).toISOString()}
        />
      )
    }
    {
      updatedTime && (
        <meta
          property="article:modified_time"
          content={new Date(updatedTime).toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="The LLM Map knowledge graph mark" />
    <title>{documentTitle}</title>
    <slot name="head" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storageKey = 'llm-map-theme';
        let setting = 'system';

        try {
          const storedSetting = window.localStorage.getItem(storageKey);
          if (
            storedSetting === 'light' ||
            storedSetting === 'dark' ||
            storedSetting === 'system'
          ) {
            setting = storedSetting;
          }
        } catch {
          // Fall back to the system theme when storage is unavailable.
        }

        const resolved =
          setting === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : setting;

        root.classList.add('has-js');
        root.dataset.theme = resolved;
        root.dataset.themeSetting = setting;
        root.style.colorScheme = resolved;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="site-shell">
      <header class="site-header">
        <a
          class="site-identity"
          href={sitePath('/')}
          aria-label={`${siteConfig.title}, home`}
        >
          <span class="site-identity__index" aria-hidden="true">01</span>
          <span>{siteConfig.title}</span>
        </a>

        <div class="site-header__tools">
          <nav class="site-nav" aria-label="Primary navigation">
            <a
              href={sitePath('/')}
              aria-current={isMapPage ? 'page' : undefined}>Map</a
            >
            <a
              href={sitePath('/writing/')}
              aria-current={isWritingPage ? 'page' : undefined}>Writing</a
            >
            <a
              href={sitePath('/topics/')}
              aria-current={isTopicsPage ? 'page' : undefined}>Topics</a
            >
            <a
              href={sitePath('/research/')}
              aria-current={isResearchPage ? 'page' : undefined}>Research</a
            >
            <a
              href={sitePath('/about/')}
              aria-current={isAboutPage ? 'page' : undefined}>About</a
            >
            <a
              href={sitePath('/search/')}
              aria-current={isSearchPage ? 'page' : undefined}>Search</a
            >
            <a href={siteConfig.repository.url}>Source</a>
          </nav>
          <ThemeToggle />
        </div>
      </header>

      <main
        id="main-content"
        tabindex="-1"
        data-pagefind-body={shouldIndexPage ? '' : undefined}
        data-pagefind-ignore={shouldIndexPage ? undefined : ''}
      >
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          An evolving research notebook by <span>{siteConfig.author.name}</span
          >.
        </p>
        <a href={siteConfig.repository.url}
          >View source on GitHub <span aria-hidden="true">↗</span></a
        >
      </footer>
    </div>

    <CodeBlockEnhancer />
  </body>
</html>
