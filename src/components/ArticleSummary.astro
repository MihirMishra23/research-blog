---
import type { ArticleMetadata } from '../types/content-ui';
import StatusLabel from './StatusLabel.astro';
import TopicLabel from './TopicLabel.astro';

interface Props {
  article: ArticleMetadata;
}

const { article } = Astro.props;
const formatDate = (value: Date | string) =>
  new Intl.DateTimeFormat('en-US', {
    dateStyle: 'long',
    timeZone: 'UTC',
  }).format(new Date(value));
const formatTerm = (value: string) => value.replaceAll('-', ' ');
---

<div class="article-summary">
  <p class="article-summary__description">{article.description}</p>

  <dl class="article-summary__metadata">
    <div>
      <dt>Published</dt>
      <dd>
        <time datetime={new Date(article.date).toISOString()}
          >{formatDate(article.date)}</time
        >
      </dd>
    </div>
    {
      article.updated && (
        <div>
          <dt>Updated</dt>
          <dd>
            <time datetime={new Date(article.updated).toISOString()}>
              {formatDate(article.updated)}
            </time>
          </dd>
        </div>
      )
    }
    <div>
      <dt>Format</dt>
      <dd>{formatTerm(article.type)}</dd>
    </div>
    <div>
      <dt>Difficulty</dt>
      <dd>{article.level}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><StatusLabel status={article.status} /></dd>
    </div>
  </dl>

  <div class="article-summary__topics">
    <span>Topics</span>
    <ul>
      {
        article.topics.map((topic) => (
          <li>
            <TopicLabel {...topic} />
          </li>
        ))
      }
    </ul>
  </div>
</div>
