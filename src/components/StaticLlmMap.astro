const children: Record<string, string[]> = {
  llms: [
    'models',
    'post-training',
    'inference',
    'multimodal',
    'agents',
    'memory',
    'interp',
  ],
  models: ['delta-attention', 'gqa', 'mla'],
  'post-training': ['sft', 'rlhf', 'grpo', 'gspo', 'dapo'],
  inference: ['flashattention', 'speculative-decoding', 'dflash', 'mtp'],
  multimodal: ['clip', 'multimodal-models', 'omni-models'],
  agents: ['mem0'],
  memory: ['lmlms'],
  interp: ['saes', 'rome', 'circuit-tracing'],
};

const nodeById = new Map(nodes.map((node) => [node.id, node]));
const edges = Object.entries(children).flatMap(([source, targets]) =>
  targets.map((target) => ({
    source: nodeById.get(source)!,
    target: nodeById.get(target)!,
  })),
);
---

<div class="static-map" aria-label="Static LLM concept map">
  <svg
    viewBox="0 0 1600 1100"
    role="img"
    aria-labelledby="llm-map-title llm-map-description"
  >
    <title id="llm-map-title">The LLM Map</title>
    <desc id="llm-map-description">
      LLMs connect to seven areas: models, post-training, inference, multimodal,
      agents, memory, and interpretability. Each area branches to the concepts
      currently on Mihir’s map.
    </desc>

    <defs>
      <pattern
        id="dot-grid"
        width="80"
        height="80"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="6" cy="6" r="2.4"></circle>
      </pattern>
    </defs>

    <rect class="map-paper" width="1600" height="1100"></rect>
    <rect class="map-grid" width="1600" height="1100" fill="url(#dot-grid)"
    ></rect>

    <g class="map-edges" aria-hidden="true">
      {
        edges.map(({ source, target }) => (
          <line x1={source.x} y1={source.y} x2={target.x} y2={target.y} />
        ))
      }
    </g>

    <g class="map-nodes">
      {
        nodes.map((node) => (
          <g class:list={['map-node', `map-node--${node.kind}`]}>
            <rect
              x={node.x - node.width / 2}
              y={node.y - node.height / 2}
              width={node.width}
              height={node.height}
              rx={node.height / 2}
            />
            <text
              x={node.x}
              y={node.y}
              text-anchor="middle"
              dominant-baseline="central"
            >
              {node.label}
            </text>
          </g>
        ))
      }
    </g>
  </svg>
</div>
